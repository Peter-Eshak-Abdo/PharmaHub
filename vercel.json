{
  "version" : 2,
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "angular"
    },
    "backend": {
      "root": "backend/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
