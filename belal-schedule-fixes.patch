-    const slots = await WeeklyAvailability.find({ doctorId }).sort({
-      dayOfWeek: 1,
-      startTime: 1,
+    // dayOfWeek is stored as a string, so a plain Mongo sort would order
+    // it alphabetically (Friday, Monday, Saturday, Sunday...) instead of
