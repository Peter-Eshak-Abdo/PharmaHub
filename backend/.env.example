# مثال لملف البيئة - انسخ هذا الملف إلى .env وعدّل القيم

# رابط الاتصال بقاعدة بيانات MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority

# المفتاح السري لتشفير JWT (غيّره لقيمة قوية)
JWT_SECRET=your_super_secret_key_here

# منفذ الخادم (اختياري، الافتراضي 8080)
PORT=8080

# إعدادات NVIDIA AI Chatbot
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

